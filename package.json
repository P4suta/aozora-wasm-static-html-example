{
  "name": "aozora-wasm-static-html-example",
  "version": "0.1.0",
  "description": "Deterministic static HTML5 library generated from Aozora Bunko notation with aozora-wasm",
  "private": true,
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://p4suta.github.io/aozora-wasm-static-html-example/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P4suta/aozora-wasm-static-html-example.git"
  },
  "bugs": {
    "url": "https://github.com/P4suta/aozora-wasm-static-html-example/issues"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "audit": "bun audit --audit-level=moderate",
    "build": "cargo run --quiet --locked --bin lab -- build --engine wasm",
    "check": "cargo run --quiet --locked --bin xtask -- check",
    "ci": "cargo run --quiet --locked --bin xtask -- ci",
    "dead-code": "knip",
    "e2e": "cargo run --quiet --locked --bin xtask -- e2e",
    "format": "cargo run --quiet --locked --bin xtask -- format",
    "format:check": "cargo run --quiet --locked --bin xtask -- format-check",
    "lab": "cargo run --quiet --locked --bin lab --",
    "lint": "cargo run --quiet --locked --bin xtask -- lint",
    "rust:test": "cargo test --locked",
    "spellcheck": "cargo run --quiet --locked --bin xtask -- spellcheck",
    "test": "cargo run --quiet --locked --bin xtask -- test",
    "typecheck": "tsc --noEmit",
    "xtask": "cargo run --quiet --locked --bin xtask --"
  },
  "dependencies": {
    "aozora-wasm": "0.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.3.14",
    "knip": "6.32.0",
    "playwright-core": "1.62.1",
    "sirv-cli": "3.0.1",
    "typescript": "7.0.2"
  }
}
