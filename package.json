{
  "name": "aozora-wasm-static-html-example",
  "version": "0.1.0",
  "description": "Deterministic static HTML5 library generated from Aozora Bunko notation with aozora-wasm",
  "private": true,
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://p4suta.github.io/aozora-wasm-static-html-example/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P4suta/aozora-wasm-static-html-example.git"
  },
  "bugs": {
    "url": "https://github.com/P4suta/aozora-wasm-static-html-example/issues"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "audit": "bun audit --audit-level=moderate",
    "build": "bun run src/cli.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage && bun run dead-code && bun run build",
    "ci": "bun run check && bun run e2e",
    "dead-code": "knip",
    "e2e": "bun run build && playwright test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aozora-wasm": "0.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "1.62.0",
    "@types/bun": "1.3.14",
    "knip": "6.29.0",
    "parse5": "8.0.1",
    "sirv-cli": "3.0.1",
    "typescript": "7.0.2"
  }
}
